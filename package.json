{
  "name": "figma-make-app",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vite",
    "dev:api": "node --env-file-if-exists=.env scripts/api.mjs",
    "dev:api:demo": "node --env-file-if-exists=.env scripts/api.mjs --demo",
    "build": "vite build",
    "check": "tsc --noEmit",
    "check:config": "node scripts/preflight.mjs",
    "check:config:live": "node scripts/preflight.mjs --live",
    "test": "node --test",
    "test:smoke": "node scripts/smoke.mjs",
    "backup": "node scripts/backup.mjs",
    "restore": "node scripts/restore.mjs",
    "package:release": "node scripts/package-release.mjs",
    "test:release": "node scripts/smoke-release.mjs",
    "start": "node --env-file-if-exists=.env server/index.mjs",
    "preview": "vite preview",
    "prepreview:admin": "npm run build",
    "preview:admin": "node scripts/admin-preview.mjs",
    "format": "oxfmt"
  },
  "dependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.0.0",
    "tailwindcss": "^4.0.0",
    "@tailwindcss/vite": "^4.0.0",
    "oxfmt": "^0.2.0",
    "typescript": "^5.7.0",
    "vite": "^8.0.5"
  }
}
