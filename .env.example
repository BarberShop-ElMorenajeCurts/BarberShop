# Copy to .env for local setup. Never commit actual credentials.
# setup: no live bookings; demo: local only, isolated data, no real events/email.
APP_MODE=setup
API_HOST=127.0.0.1
API_PORT=3001
APP_ORIGIN=http://localhost:8443
DATA_DIR=.data

# Google personal account, OAuth Web application configured in Google Cloud.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8443/api/auth/google/callback
ADMIN_GOOGLE_EMAIL=
ADMIN_GOOGLE_SUB=

# Generate locally: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
# Keep this key stable; changing it prevents reading existing encrypted tokens.
TOKEN_ENCRYPTION_KEY=
EMAIL_ENABLED=false
GOOGLE_POLL_INTERVAL_MS=60000
